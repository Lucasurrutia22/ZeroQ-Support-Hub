# Copiar a .env y completar. Nunca commitear .env real.

# Supabase Postgres — Project Settings → Database → Connection string.
# Supabase expone dos URLs distintas y Prisma las necesita separadas:
#   DATABASE_URL  -> Connection pooling (puerto 6543, pgbouncer) - la usa la app en runtime.
#   DIRECT_URL    -> Direct connection (puerto 5432) - la usa Prisma Migrate (el pooler no soporta
#                    algunas operaciones DDL de las migraciones).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET=""

# Supabase Storage (módulo Knowledge — Documentación). Project Settings → API.
# SUPABASE_SERVICE_ROLE_KEY es secreta — server-only, nunca exponerla al cliente
# ni prefijarla con NEXT_PUBLIC_.
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Search & AI (RAG) — ver docs/architecture/AI_RAG_DESIGN.md.

# Embeddings: Voyage AI (D2, fijo, no swappable por proveedor — ver diseño).
VOYAGE_API_KEY=""

# Búsqueda web del asistente IA (tool-calling, fijo a Tavily — no swappable).
# 1000 créditos gratis/mes sin tarjeta: https://tavily.com.
TAVILY_API_KEY=""

# LLM: proveedor swappable en runtime, sin tocar código (LLMProvider port +
# factory en src/modules/search-ai/infrastructure/llm/). Solo se necesitan
# las credenciales del proveedor activo, el resto puede quedar vacío.
#   anthropic | openai | azure-openai | groq | ollama
LLM_PROVIDER="anthropic"
# Opcional — si se omite, la factory usa un default razonable por proveedor
# (ver llm-provider-factory.ts). Fijarlo explícitamente evita sorpresas si el
# default cambia en una actualización futura del adapter.
LLM_MODEL=""

# --- anthropic ---
ANTHROPIC_API_KEY=""

# --- openai ---
OPENAI_API_KEY=""

# --- azure-openai --- (recurso + deployment, no el nombre del modelo base)
AZURE_OPENAI_RESOURCE_NAME=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# --- groq --- (nivel gratis real, sin tarjeta — https://console.groq.com/keys)
# Alcanzable desde Vercel a diferencia de ollama; recomendado para producción
# sin costo. Sirve modelos abiertos (Llama, gpt-oss) en hardware propio.
GROQ_API_KEY=""

# --- ollama --- (self-hosted, sin API key; solo la URL del servidor — NO
# alcanzable desde Vercel/serverless, solo sirve para desarrollo local)
OLLAMA_BASE_URL="http://127.0.0.1:11434/api"
