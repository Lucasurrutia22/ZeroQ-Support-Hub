// ZeroQ Support Hub — Prisma schema
// Alcance actual: Authentication (Identity) + Knowledge (Procedimientos,
// Categorías, Etiquetas, Versiones, Documentación, Favoritos)
// + Search & AI (RAG — ver docs/architecture/AI_RAG_DESIGN.md).
//
// Support (Clientes, Infraestructura, Casos Resueltos/Incidencias,
// Evidencias/Logs) existió acá hasta el 2026-07-29 — se eliminó por completo
// (módulo sin uso real, pedido explícito del usuario). El commit previo a la
// eliminación queda en git como respaldo si hace falta reintroducirlo.
//
// Desviaciones deliberadas respecto a DATABASE_DESIGN.md, acordadas (ver
// docs/architecture/ARCHITECTURE.md si se necesita el detalle):
//   - Sin `ReviewRequest`: el estado de Procedure transiciona directo
//     (draft -> in_review -> approved/deprecated), gateado por Policy de rol,
//     sin tabla de auditoría de revisión separada todavía.
//   - Sin `Comment`, `Attachment` — no pedidos todavía (Attachment vivía acá
//     para Evidencias/Logs de Casos, se fue con Support). `ViewHistory` sí
//     se agregó (2026-07-29, UC-EN-02) — ver modelo más abajo.
//   - `Document.clientId` sigue sin implementarse (documentos no se asocian
//     a un cliente específico todavía) — no era parte de este pedido tampoco.
//
// Prisma 7: la URL de conexión ya no vive en este archivo, se resuelve en
// prisma.config.ts (ver ese archivo para el porqué de url vs directUrl con
// el pooler de Supabase).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  supervisor
  engineer_l1
  engineer_l2
  readonly
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authoredProcedures Procedure[]        @relation("ProcedureAuthor")
  authoredVersions   ProcedureVersion[] @relation("ProcedureVersionAuthor")
  uploadedDocuments  Document[]         @relation("DocumentUploadedBy")
  favorites          Favorite[]
  aiConversations    AIConversation[]
  viewHistory        ViewHistory[]

  @@map("users")
}

enum ProcedureStatus {
  draft
  in_review
  approved
  deprecated
}

enum RiskLevel {
  low
  medium
  high
}

enum DocumentFileType {
  manual
  datasheet
  firmware_notes
  otro
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  procedures Procedure[]
  documents  Document[]

  @@index([parentId])
}

model Procedure {
  id                   String          @id @default(cuid())
  title                String
  slug                 String          @unique
  categoryId           String
  status               ProcedureStatus @default(draft)
  riskLevel            RiskLevel
  estimatedTimeMinutes Int?
  currentVersionId     String?         @unique
  authorId             String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  category       Category           @relation(fields: [categoryId], references: [id])
  author         User               @relation("ProcedureAuthor", fields: [authorId], references: [id])
  currentVersion ProcedureVersion?  @relation("ProcedureCurrentVersion", fields: [currentVersionId], references: [id])
  versions       ProcedureVersion[] @relation("ProcedureVersions")
  tags           ProcedureTag[]
  favorites      Favorite[]

  @@index([categoryId])
  @@index([status])
  @@index([authorId])
}

model ProcedureVersion {
  id              String   @id @default(cuid())
  procedureId     String
  versionNumber   Int
  contentMarkdown String   @db.Text
  changeSummary   String?
  authorId        String
  createdAt       DateTime @default(now())

  procedure Procedure  @relation("ProcedureVersions", fields: [procedureId], references: [id])
  author    User       @relation("ProcedureVersionAuthor", fields: [authorId], references: [id])
  currentOf Procedure? @relation("ProcedureCurrentVersion")

  @@unique([procedureId, versionNumber])
  @@index([procedureId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  procedures ProcedureTag[]
}

model ProcedureTag {
  procedureId String
  tagId       String

  procedure Procedure @relation(fields: [procedureId], references: [id])
  tag       Tag       @relation(fields: [tagId], references: [id])

  @@id([procedureId, tagId])
  @@index([tagId])
}

model Document {
  id           String           @id @default(cuid())
  title        String
  categoryId   String
  fileType     DocumentFileType
  storageKey   String
  uploadedBy   String
  supersedesId String?          @unique
  createdAt    DateTime         @default(now())

  category     Category  @relation(fields: [categoryId], references: [id])
  uploader     User      @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])
  supersedes   Document? @relation("DocumentSupersedes", fields: [supersedesId], references: [id])
  supersededBy Document? @relation("DocumentSupersedes")

  @@index([categoryId])
}

model Favorite {
  userId      String
  procedureId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@id([userId, procedureId])
  @@index([procedureId])
}

enum ViewedEntityType {
  procedure
  document
}

// Historial de vistas (UC-EN-02) — un registro por (usuario, entidad),
// "upsert" de viewedAt en cada visita en vez de loguear cada vista por
// separado: para "recientemente visto" alcanza con la última vez, y evita
// que la tabla crezca sin límite con usuarios que revisitan el mismo
// procedimiento seguido. Polimórfico por entityType/entityId (mismo patrón
// que DocumentChunk en Search & AI) en vez de dos FK nullable — Procedure y
// Document son bounded contexts distintos dentro de Knowledge, no vale la
// pena una tabla por tipo para una sola columna de metadata.
model ViewHistory {
  id         String           @id @default(cuid())
  userId     String
  entityType ViewedEntityType
  entityId   String
  viewedAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([userId, viewedAt])
}

// ---------------------------------------------------------------------------
// Search & AI (RAG) — ver docs/architecture/AI_RAG_DESIGN.md para el diseño
// completo (arquitectura, embeddings, chunking, prompt, retrieval, historial).
//
// Alcance de esta implementación: se indexa `Procedure` (al aprobarse, vía
// `ProcedureVersion.contentMarkdown`). `Document` queda deliberadamente
// fuera — su contenido es un archivo binario (PDF/manual) sin texto
// extraído; indexarlo requiere un paso de extracción de texto (OCR/parsing)
// que no forma parte de este pedido y se retoma cuando se pida el caso de
// uso de análisis de archivos.
//
// `embedding` usa `Unsupported(...)` porque Prisma no modela `vector`/
// `halfvec` nativamente (D1). La columna real, su extensión (`CREATE
// EXTENSION vector`), el índice HNSW y la columna generada `tsvector` para
// full-text (retrieval híbrido) se crean a mano — ver prisma/manual-sql/.
// Ningún campo de este bloque se toca por Prisma Client salvo lectura/
// escritura de las columnas no-vector; `embedding` y el `tsvector` derivado
// se escriben/leen exclusivamente vía $executeRaw/$queryRaw en
// PgVectorStore (mismo patrón ya usado para el CHECK de `Attachment`: campos
// que Prisma no puede expresar se documentan acá y se aplican por SQL manual).
//
// Se eligió `halfvec(1024)` en vez de `vector(1024)` (que decía
// ARCHITECTURE.md §5.2 originalmente) siguiendo el golden path de la skill
// `pgvector-semantic-search`: mismo recall, mitad de espacio de
// almacenamiento/índice — refinamiento de implementación, no un cambio de
// decisión arquitectónica.
// Solo "procedure_version" desde que el módulo Cases (que aportaba
// "resolved_case") se eliminó (2026-07-29). Union type por si se reintroduce
// contenido de casos resueltos más adelante.
enum DocumentChunkSourceType {
  procedure_version
}

model DocumentChunk {
  id         String                        @id @default(cuid())
  sourceType DocumentChunkSourceType
  sourceId   String
  content    String                        @db.Text
  // Nullable a nivel Prisma: la fila se crea primero sin embedding (Prisma
  // Client no puede escribir un campo Unsupported), y un segundo paso en
  // PgVectorStore.insertChunks() la completa vía $executeRaw en la misma
  // operación de indexación — nunca queda una fila sin embedding en reposo.
  embedding  Unsupported("halfvec(1024)")?
  chunkIndex Int
  categoryId String?
  createdAt  DateTime                      @default(now())

  @@index([sourceType, sourceId])
  @@index([categoryId])
}

enum AIMessageRole {
  user
  assistant
}

// Origen de una respuesta de asistente: "cache" (memoria semántica,
// AICachedAnswer, sin llamar al LLM), "quick" (match interno fuerte) o
// "deep" (match débil/ambiguo — la UI se lo marca al usuario como análisis
// más profundo). Null en mensajes role=user. Ver ask-ai.ts.
enum AIAnswerOrigin {
  cache
  quick
  deep
}

// Historial de conversaciones con la IA (distinto de `ViewHistory`, que es
// historial de páginas vistas — ver AI_RAG_DESIGN.md §6). Privado por
// usuario: no hay query "ver conversaciones de otro usuario" en este alcance.
model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id               String        @id @default(cuid())
  conversationId   String
  role             AIMessageRole
  content          String        @db.Text
  // Array de { type: "procedure_version"|"web", sourceId, title, url } —
  // null en mensajes role=user, obligatorio en mensajes role=assistant que
  // citan contexto (invariante de trazabilidad, ver AI_RAG_DESIGN.md §4.3).
  sourceReferences Json?
  // Solo en mensajes role=assistant — ver enum AIAnswerOrigin.
  answerOrigin     AIAnswerOrigin?
  createdAt        DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}

// Memoria semántica del asistente de IA: respuestas ya generadas y
// consideradas confiables (hasSufficientContext=true + al menos una cita
// interna, ver askAI), indexadas por el embedding de la PREGUNTA que las
// originó — no del contenido de Bitácora (eso ya lo indexa DocumentChunk).
// Un query nuevo con embedding muy similar a `questionText` reusa
// `answerContent` en vez de volver a llamar al LLM (el cuello de botella real
// de latencia, ver AI_RAG_DESIGN.md/memoria del proyecto sobre Ollama).
model AICachedAnswer {
  id               String   @id @default(cuid())
  questionText     String   @db.Text
  // Nullable a nivel Prisma por la misma razón que DocumentChunk.embedding:
  // se completa vía $executeRaw en PgAnswerCacheStore.save(), nunca queda
  // una fila sin embedding en reposo.
  embedding        Unsupported("halfvec(1024)")?
  answerContent    String   @db.Text
  sourceReferences Json
  hitCount         Int      @default(0)
  createdAt        DateTime @default(now())
  lastHitAt        DateTime @default(now())

  citations AICachedAnswerCitation[]
}

// Qué Procedures respaldan una respuesta cacheada — permite invalidar por
// Procedure editado/depreciado sin tener que escanear el JSON de citas
// (ver editProcedureContent/deprecateProcedure en knowledge/procedures.ts).
model AICachedAnswerCitation {
  id             String @id @default(cuid())
  cachedAnswerId String
  procedureId    String

  cachedAnswer AICachedAnswer @relation(fields: [cachedAnswerId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}
